# Copy to .env and fill in. docker-compose reads this for the neo4j and
# splunk containers' bootstrap passwords, and passes it through to soc-api.

NEO4J_PASSWORD=changeme123

SPLUNK_PASSWORD=Changeme123!
SPLUNK_HEC_TOKEN=soc-ai-hec-token

# Ollama Cloud API key (https://ollama.com/settings/keys) — required for
# the reasoning/chat model (LLM_MODEL, default gemma4:cloud). Only
# embeddings run against the local Ollama container; anything tagged
# "*:cloud" is called directly against https://ollama.com/api instead.
OLLAMA_API_KEY=

# Optional: Discord webhook for alert notifications (used by the existing
# alert_analyzer.py; the soc-api service doesn't post to Discord itself —
# Splunk/Elastic write-back goes to HEC / a verdicts index instead).
DISCORD_WEBHOOK=
